# Copy to .env. Never commit .env. Default frontend is the browser demo.
VITE_STORAGE_MODE=browser
VITE_BASE_PATH=/avtofakultet-demo/
# Only public API URL belongs in VITE_ variables. Never put a token here.
VITE_API_URL=

# Separate test bot only. Existing hi_prof_bot is explicitly blocked at startup.
BOT_TOKEN=
TEST_BOT_USERNAME=
MINI_APP_URL=https://your-connected-frontend.example/
ADMIN_TELEGRAM_IDS=
# A private user ID included in ADMIN_TELEGRAM_IDS. That admin must /start the test bot.
TEST_ADMIN_CHAT_ID=
DATABASE_PATH=./data/applications.sqlite
PORT=3001
ALLOWED_ORIGINS=https://your-connected-frontend.example
